# Copy this to .env in the repository root before `docker compose -f deploy/compose.yaml up --build -d`.
# Never commit the real .env. Use long random passwords/tokens generated on your server.
ARENA_DOMAIN=arena.example.com
POSTGRES_PASSWORD=replace-with-long-random-password
ARENA_RUNNER_TOKEN=replace-with-another-long-random-token
# Optional remote LSP: build the images with the commands in docs/LANGUAGE_SERVERS.md first.
ARENA_LSP_LANGUAGES=
ARENA_LSP_IMAGES={}
ARENA_LSP_MAX_SESSIONS=8
# Isolated hosted previews: max concurrent previews and time-to-live (ms).
ARENA_PREVIEW_MAX_SESSIONS=4
ARENA_PREVIEW_TTL_MS=900000
# Linux host absolute path, shared identically with the runner container for Docker bind mounts.
ARENA_RUNNER_DATA_HOST=/srv/arena-runner
ARENA_ALLOW_SIGNUP=1
# Optional AI provider (without this, chat reports demo mode; local/browser inference remains separate).
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODELS=openai/gpt-4.1
# Optional deploy adapter. Must be an endpoint you control that validates its own authorization and archive.
ARENA_DEPLOY_WEBHOOK_URL=
ARENA_DEPLOY_WEBHOOK_TOKEN=
# Per-account quotas; zero disables a daily limit (not recommended for public service).
ARENA_MAX_USER_WORKSPACES=20
ARENA_MAX_USER_CHAT_PER_DAY=50
ARENA_MAX_USER_RUNS_PER_DAY=100
ARENA_MAX_USER_DEPLOYS_PER_DAY=10
